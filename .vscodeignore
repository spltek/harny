# Sources & tooling — the shipped runtime is the bundled dist/extension.js
src/**
tests/**
build/**
.cache/**
docs/**
documentation/**
.github/**
.vscode/**
node_modules/**
**/*.ts

# `docs/` is what GitHub Pages PUBLISHES (the site: index.html + assets/, plus `docs/images/`
# where the README's presentation art lives). `documentation/` is the reference material
# (RELEASE.md, MIGRATIONS.md, REFERENCE_TOOLS.json, config.example.jsonc) — for the repo, not
# for the site. Neither is runtime, so both trees are excluded.

# README / presentation media is TRACKED in `docs/images/` and NEVER shipped: a 733 KB
# wallpaper is presentation, not runtime, and every install would carry it forever. The excludes
# above already cover it — do NOT add a `!docs/images/…` exception, that turns a
# wallpaper back into payload. The full folder is pinned by a test, not by this comment
# (package-manifest.test.ts).

# Keep the built host bundle (excluded above by nothing, but be explicit)
!dist/**

# Icon artwork is INLINED into the bundles at build time (loader: .svg = text),
# so the sources of media/icons/ (and its README, and the contact sheet) never ship.
# EXCEPT the brand, which is the one artwork the runtime FETCHES instead of carrying:
# the activity bar and the marketplace read their icon straight off disk, and the
# panel loads the mark as an <img> through asWebviewUri. Excluding these three is
# how an extension ships with a blank activity-bar icon.
media/icons/**
!media/icons/harny.svg
!media/icons/harny-app.svg
!media/icons/harny.png

# Repo/tooling files not needed at runtime
tsconfig.json
tsconfig.webview.json
.eslintrc.json
.gitignore
*.vsix
.DS_Store

# Generated reports (the mutation JSON, Stryker's sandbox) and the coverage tree are all
# covered by `.cache/**` above — one line, and a stale run cannot ride along in the .vsix.




# The repo examples are gone from the root and split by what they ARE: the config template is
# documentation (`documentation/config.example.jsonc`), the demo MCP server is a test fixture the suite
# SPAWNS (`tests/mcp-hello/server.js`). Both trees are excluded above, so neither ships.

# `vsce` packs the WORKING TREE (not the git index), so tracked DEV files a user never
# needs ride along: prettier's config is a formatter's, and .git-blame-ignore-revs is for
# `git blame`. Neither is read at runtime.
prettier.config.mjs
.prettierignore
.git-blame-ignore-revs
# The stylesheet reaches the panel through the GENERATED module src/chat/view-css.ts
# (scripts/gen-view-css.mjs): shipping the .css source too would be a second, dead copy of it.
media/view.css
