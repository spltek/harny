# Sources & tooling — the shipped runtime is the bundled dist/extension.js
src/**
scripts/**
coverage/**
docs/**
.github/**
.vscode/**
node_modules/**
**/*.ts

# Keep the built host bundle (excluded above by nothing, but be explicit)
!dist/**

# Icon artwork is INLINED into the bundles at build time (loader: .svg = text),
# so the sources of media/icons/ (and its README) never ship.
media/icons/**

# Repo/tooling files not needed at runtime
tsconfig.json
tsconfig.webview.json
vitest.config.mts
.eslintrc.json
.gitignore
*.vsix
.DS_Store

# Stryker's report lands here (`npm run mutate:*`): 680 KB of mutation JSON that a
# user never opens. `vsce` packs the WORKING TREE, so without this line the last
# local mutation run rides along in the .vsix.
reports/**

# Mutation-testing matrices (`npm run mutate:*`): read by Stryker, never by the extension.
# The globs INSIDE them are cwd-relative (Stryker docs), so the folder move changed no glob —
# it only stops 8 dev-only JSONs from riding along in the .vsix.
stryker/**

# Repo examples — the demo MCP server and the config template. They are "copy from the repo",
# not parts of the extension; this line also covers the former `config.example.jsonc`.
examples/**

# `vsce` packs the WORKING TREE (not the git index), so tracked DEV files a user never
# needs ride along: prettier's config is a formatter's, and .git-blame-ignore-revs is for
# `git blame`. Neither is read at runtime.
prettier.config.mjs
.prettierignore
.git-blame-ignore-revs
# The stylesheet reaches the panel through the GENERATED module src/chat/view-css.ts
# (scripts/gen-view-css.mjs): shipping the .css source too would be a second, dead copy of it.
media/view.css
