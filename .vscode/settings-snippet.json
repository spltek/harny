{
  // Add these lines to your VS Code settings.json (Cmd+Shift+P → "Preferences: Open Settings (JSON)")

  // ─── OpenAI, directly ───
  "harny.provider": "openai",
  "harny.apiKey": "sk-your-key-here",
  "harny.model": "gpt-4o",

