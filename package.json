{
  "name": "harny",
  "displayName": "Harny - AI Coding Harness",
  "description": "AI coding harness for VSCodium and VS Code — fast and packed with features, built on a SOLID core. Any OpenAI-compatible endpoint works out of the box.",
  "version": "0.9.8",
  "publisher": "spltek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spltek/harny"
  },
  "homepage": "https://open-vsx.org/extension/spltek/harny",
  "bugs": {
    "url": "https://github.com/spltek/harny/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "ai agent",
    "agent",
    "chat",
    "chatgpt",
    "copilot",
    "llm",
    "local llm",
    "ollama",
    "llama.cpp",
    "openrouter",
    "deepseek",
    "mcp",
    "model context protocol",
    "skills",
    "code assistant",
    "local-first"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode (an untrusted folder) Harny stays fully visible and works read-only: it can read, search and PREPARE changes as validated previews, but it does not write files, run commands or load the workspace's own skills until you trust the folder. Build comes back as soon as you do."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harny",
          "title": "Harny",
          "icon": "media/icon.svg",
          "side": "right"
        }
      ]
    },
    "views": {
      "harny": [
        {
          "type": "webview",
          "id": "harny.chatView",
          "name": "Harny Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Harny",
      "properties": {
        "harny.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow the editor: Harny uses its light palette when the VS Code theme is a light one, its dark palette otherwise (default)",
            "Always the dark palette (terracotta on anthracite), whatever the editor theme is",
            "Always the light palette (terracotta on warm paper), whatever the editor theme is"
          ],
          "description": "Which of Harny's two palettes the chat panel uses. Harny keeps its own look in both: it does not adopt the theme's colors, it only follows its light/dark kind, so the panel re-skins instantly when you change theme."
        }
      }
    },
    "keybindings": [
      {
        "command": "harny.findInChat",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == harny.chatView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/gen-view-css.mjs && node scripts/build-extension.mjs && node scripts/build-webview.mjs",
    "gen:css": "node scripts/gen-view-css.mjs",
    "typecheck": "npx tsc --noEmit && npx tsc -p tsconfig.webview.json",
    "watch": "npx tsc -p tsconfig.json --watch",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run format:check && npm test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run stryker/default.conf.json",
    "mutate:compactor": "stryker run stryker/compactor.conf.json",
    "mutate:loop-guard": "stryker run stryker/loop-guard.conf.json",
    "mutate:overflow": "stryker run stryker/overflow.conf.json",
    "mutate:tool-scope": "stryker run stryker/tool-scope.conf.json",
    "mutate:mode-policy": "stryker run stryker/mode-policy.conf.json",
    "mutate:webview": "stryker run stryker/webview.conf.json",
    "mutate:chat-panel": "stryker run stryker/chat-panel.conf.json",
    "mutate:ratchet": "npm run mutate:compactor && npm run mutate:loop-guard && npm run mutate:overflow && npm run mutate:tool-scope && npm run mutate:mode-policy && npm run mutate:webview && npm run mutate:chat-panel",
    "package": "vsce package --no-dependencies",
    "format": "prettier --write 'src/**/*.ts' 'media/*.css'",
    "format:check": "prettier --check 'src/**/*.ts' 'media/*.css'"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.101.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2",
    "qs": "^6.17.1",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "ignore": "^7.0.14",
    "markdown-it": "^15.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prismjs": "^1.30.0"
  }
}
