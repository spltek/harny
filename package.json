{
  "name": "harny",
  "displayName": "Harny - AI Coding Harness",
  "description": "AI coding harness for VSCodium and VS Code — fast and packed with features, built on a SOLID core. Any OpenAI-compatible endpoint works out of the box.",
  "version": "0.9.4",
  "publisher": "spltek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spltek/harny"
  },
  "homepage": "https://open-vsx.org/extension/spltek/harny",
  "bugs": {
    "url": "https://github.com/spltek/harny/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "ai agent",
    "agent",
    "chat",
    "chatgpt",
    "copilot",
    "llm",
    "local llm",
    "ollama",
    "llama.cpp",
    "openrouter",
    "deepseek",
    "mcp",
    "model context protocol",
    "skills",
    "code assistant",
    "local-first"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harny",
          "title": "Harny",
          "icon": "media/icon.svg",
          "side": "right"
        }
      ]
    },
    "views": {
      "harny": [
        {
          "type": "webview",
          "id": "harny.chatView",
          "name": "Harny Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Harny",
      "properties": {
        "harny.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow the editor: Harny uses its light palette when the VS Code theme is a light one, its dark palette otherwise (default)",
            "Always the dark palette (terracotta on anthracite), whatever the editor theme is",
            "Always the light palette (terracotta on warm paper), whatever the editor theme is"
          ],
          "description": "Which of Harny's two palettes the chat panel uses. Harny keeps its own look in both: it does not adopt the theme's colors, it only follows its light/dark kind, so the panel re-skins instantly when you change theme."
        }
      }
    },
    "keybindings": [
      {
        "command": "harny.findInChat",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == harny.chatView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build-extension.mjs && node scripts/build-webview.mjs",
    "typecheck": "npx tsc --noEmit && npx tsc -p tsconfig.webview.json",
    "watch": "npx tsc -p tsconfig.json --watch",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run format:check && npm test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "package": "vsce package --no-dependencies",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.101.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "ignore": "^7.0.14",
    "markdown-it": "^15.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prismjs": "^1.30.0"
  }
}
