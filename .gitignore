# Dependencies
node_modules/

# Build output
dist/
out/
*.tsbuildinfo

# Webview client bundle — generated by `node build/scripts/build-webview.mjs`
# (keep committed so the extension runs without a build step; uncomment
#  if you prefer a source-only repo)
# media/view.js

# Every GENERATED report lives under one ignored roof: the coverage tree, the mutation JSON
# and Stryker's sandbox. The tools are told to write there — vitest
# `coverage.reportsDirectory`, Stryker `jsonReporter.fileName` / `tempDirName` — so the root
# keeps ONE transient folder instead of three.
.cache/

# VS Code extension packaging
*.vsix

# Environment / secrets — never committed. There is deliberately no `.env.example`: nothing in
# this repo reads a `.env` file. The two variables the extension actually honours
# (`OPENAI_API_KEY`, `HARNY_HOME`) are SHELL env vars, documented in README.
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Extension testing
.vscode-test/

# Profiles of the debug host and of the test host (see .vscode/launch.json).
.vscode/dev-profile/
.vscode/dev-extensions/
.vscode/test-profile/
.vscode/test-extensions/
