# Dependencies
node_modules/

# Build output
dist/
out/
*.tsbuildinfo

# Webview client bundle — generated by `node scripts/build-webview.mjs`
# (keep committed so the extension runs without a build step; uncomment
#  if you prefer a source-only repo)
# media/view.js

# Test coverage report (regenerated by `npm run coverage`)
coverage/

# Mutation testing (regenerated by `npm run mutate`)
reports/
.stryker-tmp/

# VS Code extension packaging
*.vsix

# Environment / secrets (commit only .env.example)
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Extension testing
.vscode-test/

# Profiles of the debug host and of the test host (see .vscode/launch.json).
.vscode/dev-profile/
.vscode/dev-extensions/
.vscode/test-profile/
.vscode/test-extensions/
