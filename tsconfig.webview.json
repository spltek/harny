{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/chat/webview/**/*.ts", "src/chat/webview/**/*.d.ts", "src/chat/svg-modules.d.ts"]
}
