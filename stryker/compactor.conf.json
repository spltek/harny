{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tsconfigFile": "stryker/no-tsconfig-rewrite.json",
  "testRunner": "vitest",
  "mutate": [
    "src/core/sessions/compactor.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 92.77,
    "low": 92.6,
    "break": 92.6
  }
}
