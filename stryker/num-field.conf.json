{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tsconfigFile": "stryker/no-tsconfig-rewrite.json",
  "testRunner": "vitest",
  "mutate": ["src/chat/webview/num-field.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 99.64,
    "low": 99.46,
    "break": 99.46
  }
}
