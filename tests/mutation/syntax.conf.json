{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tsconfigFile": "tests/mutation/no-tsconfig-rewrite.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "tests/vitest.config.mts"
  },
  "tempDirName": ".cache/stryker-tmp",
  "mutate": [
    "src/chat/webview/highlight.ts",
    "src/chat/webview/lang-map.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": ".cache/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 100,
    "low": 90,
    "break": 90
  }
}
