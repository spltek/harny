{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tsconfigFile": "tests/mutation/no-tsconfig-rewrite.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "tests/vitest.config.mts" },
  "tempDirName": ".cache/stryker-tmp",
  "mutate": [
    "src/core/sessions/compactor.ts",
    "src/core/agent/loop-guard.ts",
    "src/core/llm/context-overflow.ts",
    "src/core/tools/tool-scope.ts",
    "src/core/tools/mode-policy.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": ".cache/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 94.38,
    "low": 94.34,
    "break": 94.34
  }
}
