{
  // ============================================================
  // FORMAT 1 — Flat (simple)
  // ============================================================
  // "apiKey": "sk-...",
  // "provider": "openai",                 // "openai" | "openai-compatible" | "anthropic"
  // "baseUrl": "https://api.openai.com",
  // "model": "gpt-4o",
  // "maxTokens": 4096,
  // "temperature": 0.1,
  // "autoOpen": false

  // ============================================================
  // FORMAT 2 — Multiple providers (map)
  // "provider" selects which entry to use; "model" which model.
  // ============================================================
  "provider": "llamacpp",
  // "model" is written automatically by Harny when you pick one from the
  // dropdown. The model list is ALWAYS fetched from the host (GET /v1/models).
  // "model": "LLM/Qwen3.8-27B-UD-Q6_K.gguf",
  "providers": {
    "llamacpp": {
      "baseUrl": "http://localhost:8090/v1",
      "api": "openai-completions",
      "apiKey": "lamacpp",
      "thinking": "bool", // "bool" (llama.cpp kwargs) | "effort" (reasoning_effort) | "type" (thinking.type) | "reasoning" (OpenRouter) | "unspecified" (send nothing)
      // No "models": the dropdown shows the GGUF currently loaded in the server.
      // llama.cpp loads ONE model at a time, so the list is always that one.
    },
    // Hosted provider with a dynamic model list: just apiKey + baseUrl.
    // The list is fetched from the host (GET /v1/models) and shown in the
    // dropdown (same as every other provider).
    "opencode-go": {
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "api": "openai-completions",
      "apiKey": "sk-...",
      "thinking": "type", // DeepSeek/Anthropic-style thinking: { type: "enabled" | "disabled" }
      "thinkingLevel": "high"
      // no "models": the list comes from the host
    },
    // OpenRouter is OpenAI-compatible. Declared WITHOUT "models" so the
    // dropdown auto-fills from GET /v1/models (hundreds of hosted models).
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "api": "openai-completions",
      "apiKey": "sk-or-...",
      "thinking": "reasoning" // OpenRouter-native: reasoning.effort / enabled:false (reliable off for DeepSeek)
    },
    // Local provider without apiKey: works the same, dynamic list.
    // "ollama": {
    //   "baseUrl": "http://localhost:11434/v1",
    //   "api": "openai-completions",
    //   "apiKey": "ollama"
    // }
  },
  // MCP servers: a server is EITHER a command (stdio) OR a URL (HTTP). The panel's MCP card
  // edits everything except `analyze`, which is the only field without a control in the form.
  "mcpServers": {
    // A local server, started as a process.
    // "sqlite": {
    //   "command": "npx",
    //   "args": ["-y", "mcp-sqlite", "./data.db"],
    //   "env": { "LOG_LEVEL": "warn" },
    //   // The MACHINE's switch: false = installed here but not connected at all. Which
    //   // sessions USE it is theirs to decide (the switch in the MCP card).
    //   "enabled": true,
    //   // Analyze: "read-only" (every tool of it) or "trusted" (believe its own
    //   // readOnlyHint). OMITTED = none of its tools runs in Analyze — the strictest
    //   // default, and the reason a tool that modifies things cannot run there by
    //   // accident. Per-TOOL exceptions are the shield in the tools panel (analyzeTools).
    //   "analyze": "trusted",
    //   // The SEED for a new session: every NEW conversation starts with these tools off.
    //   // Which tools a conversation actually uses is a PER-SESSION decision (the checkboxes
    //   // in the tools panel), so this list does not veto anything globally any more — the
    //   // panel no longer writes it either, and an existing session keeps its own choice.
    //   "excludeTools": ["drop_table", "delete_row"]
    // },
    // A remote server: no command, an URL and optional headers.
    // "docs": {
    //   "url": "https://learn.microsoft.com/api/mcp",
    //   "headers": { "Authorization": "Bearer ..." },
    //   "analyze": "read-only"
    // }
  }
}
