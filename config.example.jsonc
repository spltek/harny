{
  // ============================================================
  // FORMAT 1 — Flat (simple)
  // ============================================================
  // "apiKey": "sk-...",
  // "provider": "openai",                 // "openai" | "openai-compatible" | "anthropic"
  // "baseUrl": "https://api.openai.com",
  // "model": "gpt-4o",
  // "maxTokens": 4096,
  // "temperature": 0.1,
  // "autoOpen": false

  // ============================================================
  // FORMAT 2 — Multiple providers (map)
  // "provider" selects which entry to use; "model" which model.
  // ============================================================
  "provider": "llamacpp",
  // "model" is written automatically by Harny when you pick one from the
  // dropdown. The model list is ALWAYS fetched from the host (GET /v1/models).
  // "model": "LLM/Qwen3.8-27B-UD-Q6_K.gguf",
  "providers": {
    "llamacpp": {
      "baseUrl": "http://localhost:8090/v1",
      "api": "openai-completions",
      "apiKey": "lamacpp",
      "thinking": "bool", // "bool" (llama.cpp kwargs) | "effort" (reasoning_effort) | "type" (thinking.type) | "reasoning" (OpenRouter) | "unspecified" (send nothing)
      // No "models": the dropdown shows the GGUF currently loaded in the server.
      // llama.cpp loads ONE model at a time, so the list is always that one.
    },
    // Hosted provider with a dynamic model list: just apiKey + baseUrl.
    // The list is fetched from the host (GET /v1/models) and shown in the
    // dropdown (same as every other provider).
    "opencode-go": {
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "api": "openai-completions",
      "apiKey": "sk-...",
      "thinking": "type", // DeepSeek/Anthropic-style thinking: { type: "enabled" | "disabled" }
      "thinkingLevel": "high"
      // no "models": the list comes from the host
    },
    // OpenRouter is OpenAI-compatible. Declared WITHOUT "models" so the
    // dropdown auto-fills from GET /v1/models (hundreds of hosted models).
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "api": "openai-completions",
      "apiKey": "sk-or-...",
      "thinking": "reasoning" // OpenRouter-native: reasoning.effort / enabled:false (reliable off for DeepSeek)
    },
    // Local provider without apiKey: works the same, dynamic list.
    // "ollama": {
    //   "baseUrl": "http://localhost:11434/v1",
    //   "api": "openai-completions",
    //   "apiKey": "ollama"
    // }
  }
}
